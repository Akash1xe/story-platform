{
  "name": "story-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @story-platform/web dev",
    "build:web": "pnpm --filter @story-platform/web build",
    "lint:web": "pnpm --filter @story-platform/web lint",
    "typecheck:web": "pnpm --filter @story-platform/web typecheck",
    "dev:api": "pnpm --filter @story-platform/api dev",
    "build:api": "pnpm --filter @story-platform/api build",
    "typecheck:api": "pnpm --filter @story-platform/api typecheck",
    "db:generate": "pnpm --filter @story-platform/api db:generate",
    "db:migrate": "pnpm --filter @story-platform/api db:migrate",
    "db:deploy": "pnpm --filter @story-platform/api db:deploy",
    "db:studio": "pnpm --filter @story-platform/api db:studio"
  }
}
